{
  /*
    The video folder was not being typechecked by anything.

    `tsconfig.app.json` includes only `src`, and the root config references just
    that and `vite.config.ts`. So `npx tsc -b` compiled the app, reported
    success, and never opened a single file under `video/`. Every green
    typecheck on the lesson videos was a green light from a check that was not
    looking at them.

    This is the missing third project. It is referenced from the root config so
    that `tsc -b` covers it from now on, which is the only version of this fix
    that cannot be forgotten.

    `strict` is on here although the app does not set it, because these files
    reach into three plain browser scripts through `any` and the compiler is the
    only thing standing between a typo in a scene painter and a video that
    renders a blank rectangle for sixty seconds.
  */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.video.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    /*
      Not `noUnusedLocals`. A scene painter is handed `(ctx, w, h, t, scene)`
      whether or not it needs all five, and making every painter destructure
      around that would be noise in forty files.
    */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true
  },
  "include": ["video"]
}
