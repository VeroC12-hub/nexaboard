VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ---------------------------------------------------------------------------
# The tutor in Phase 2. See docs/tutor.md.
#
# Two routes, and neither puts a key in the browser. The free one is the
# default: a machine you own, signed into Claude Code, answers through the
# queue, and nothing is billed per token.
# ---------------------------------------------------------------------------

# The queue. Set these three and run tools/tutor-worker.mjs on your machine.
# The service key is NOT the anon key, and must never be given a VITE_ prefix,
# because anything prefixed VITE_ is compiled into the public bundle.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
EDU_WORKER_SECRET=

# Optional, and only if you want to pay per token instead. Server side only:
# read by api/tutor.js, never sent to the browser. Without it the queue answers,
# and without either the courses still teach and the tutor says it is off.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Pictures and video in lessons. See docs/visuals.md.
#
# Diagrams are drawn by the tutor itself as SVG and need none of this: they are
# free, instant, and their labels are correct. These two open weight models are
# only for photographs and short clips, which carry no words and no quantities
# because neither model can spell.
#
# Server side only. Roughly 4 cents per second of 480p video, so this is opt in
# per learner per topic and never automatic.
# ---------------------------------------------------------------------------
FAL_KEY=

# Test without a GPU or a bill: placeholders that say TEST RENDER on them and
# print the prompt they were given, so the whole path runs offline and free.
# Never set this on a deployment real learners use.
# EDU_RENDERER=local
# EDU_RENDER_DELAY=1

# Real images from FLUX with no key and no bill, watermarked, and no video.
# The prompt goes to a free third party service without a contract, so this is
# opt in. See docs/visuals.md.
# EDU_RENDERER=free

# Optional overrides. Model names move faster than this file will.
# EDU_IMAGE_MODEL=fal-ai/flux/schnell
# EDU_VIDEO_MODEL=fal-ai/wan/v2.2-5b/text-to-video

# ---------------------------------------------------------------------------
# NARRATION for the lesson videos. Worker machine only: the voice is recorded
# to a file before the render, so this is never read in the browser. The games
# speak through the browser's own voice instead and need nothing here.
#
# Default on Windows is `sapi`, which is Windows' own speech synthesis through
# PowerShell: free, offline, already installed, and it has an en-GB voice.
# Default everywhere else is `none`, which renders the video with the line on
# screen as a subtitle and no voice.
#
# `piper` is open source, MIT, runs on a CPU and sounds markedly better. It
# needs about 60 MB of voice model downloaded, which is why it is not default.
# See docs/sound.md.
# ---------------------------------------------------------------------------
# EDU_TTS=sapi
# EDU_TTS_VOICE=Microsoft Hazel Desktop
# EDU_TTS_RATE=-2
# EDU_TTS=piper
# PIPER_BIN=C:/piper/piper.exe
# PIPER_VOICE=C:/piper/en_GB-alba-medium.onnx
