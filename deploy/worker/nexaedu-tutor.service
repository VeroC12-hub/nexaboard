[Unit]
Description=NEXA-EDU tutor worker
Documentation=https://github.com/VeroC12-hub/nexaboard/blob/master/deploy/worker/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/nexaboard
EnvironmentFile=/etc/nexaedu.env
ExecStart=/usr/bin/npm run tutor:prod

# The worker polls a queue and holds nothing, so being restarted costs at most
# one job, which the queue reclaims after fifteen minutes anyway. Staying down
# costs every lesson on the platform, and does it silently.
Restart=always
RestartSec=10

# A crash loop is the one case where restarting for ever is wrong: without this
# a missing token would be retried every ten seconds until somebody noticed.
StartLimitIntervalSec=300
StartLimitBurst=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexaedu-tutor

# It writes prose and a usage log. It has no business anywhere else on the box.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/nexaedu

[Install]
WantedBy=multi-user.target
